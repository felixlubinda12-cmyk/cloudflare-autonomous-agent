# Cloudflare Autonomous Agent - Phase 1 Environment Configuration
# Copy this file to .dev.vars for local Wrangler development:
#   cp .env.example .dev.vars
# For production deployment, set secrets using:
#   npx wrangler secret put <NAME>

# Gemini API Key for model reasoning
GEMINI_API_KEY="your-gemini-api-key-here"

# Cloudflare API Token with permissions over the playground account
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token-here"

# Cloudflare Account ID for the agent's playground account
CLOUDFLARE_ACCOUNT_ID="7acc438ecf125d6eac5e140bcfb70d4f"

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"

# Secret token used by Telegram webhook header: X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret-token-here"

# Telegram user ID or chat ID of the authorized owner (single-owner Phase 1)
TELEGRAM_OWNER_ID="your-telegram-user-id"

# Phase 2: Gemini Fallback API Key (used if primary encounters quota 429 / 503 errors)
GEMINI_FALLBACK_API_KEY="your-secondary-gemini-api-key-here"

# Phase 2: Dedicated GitHub Playground Repository Credentials
# Fine-grained PAT restricted by GitHub strictly to exactly ONE dedicated playground repository
# (Repository owner and name are automatically discovered from the token via the GitHub API)
GITHUB_TOKEN="ghp_your-playground-scoped-github-token-here"

# Optional Configuration
GEMINI_MODEL="gemini-3.8-flash"
AGENT_MAX_ITERATIONS="8"
LOG_LEVEL="info"
ENVIRONMENT="production"
